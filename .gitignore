# 依赖
node_modules/

# 构建产物
dist/
dist-portable/
src-tauri/target/
src-tauri/target-*/
src-tauri/gen/schemas/

# 运行数据（聊天记录、身份私钥 —— 绝不能提交）
/data/
*.baker-identity.json
**/events.log
**/events.log.*

# 自己的素材（见 src/assets/README.md）
#
# 注意：不要整目录忽略 src/assets/baker/ —— 仓库里有两张**占位图**
# （background/app-background.webp、deco/achievement_main_deco05.png），
# 它们是静态 import，缺了会编译失败。只忽略用户自己塞素材的这几个目录。
src/assets/baker/extracted/
src/assets/fonts/*.ttf
src/assets/fonts/*.otf

# 临时目录 / 工具产物
.tmp/
.cache/
.graphflow/
graphflow-out/
shots/
*.log
npm-debug.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 自检脚本的 esbuild 产物
tools/.crypto-selftest.mjs
tools/.e2e.mjs
