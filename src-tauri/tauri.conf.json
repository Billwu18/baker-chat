{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BAKER",
  "version": "0.1.0",
  "identifier": "beer.peilika.bakerchat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BAKER",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 576,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#2c2c2c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "SocialNetworking",
    "shortDescription": "BAKER 风格的即时通讯客户端",
    "longDescription": "一比一复刻《明日方舟：终末地》BAKER 界面的桌面即时通讯客户端（Windows）。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
